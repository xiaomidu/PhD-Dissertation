  language    = "en",
  original_id = "8ef69cbf-f0fa-0023-a3a4-5b838a93aade"
}

@ARTICLE{Cavero-Redondo2019-ce,
  title    = "Metabolic Syndrome Including Glycated Hemoglobin A1c in Adults:
              Is It Time to Change?",
  author   = "Cavero-Redondo, Iv{\'a}n and Mart{\'\i}nez-Vizca{\'\i}no, Vicente
