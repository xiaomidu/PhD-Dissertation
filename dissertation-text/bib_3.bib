  keywords = "3-isobutyl-1-methylxanthine; MDI; ADASC; SV40 T large antigen;
              WAT; adipocyte precursor; adipocyte precursor; IBMX;
              adipogenesis; adipose tissue derived adult stem cells; AP; and
              IBMX adipogenic differentiation cocktail; SV40 T-Ag; cell
              culture; dexamethonsone; immortalization; insulin; preadipocyte;
              white adipose tissue",
  language = "en"
}

