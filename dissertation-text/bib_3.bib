@ARTICLE{DeForest2024-ex,
  title     = "Genome-wide discovery and integrative genomic characterization
               of insulin resistance loci using serum triglycerides to
               {HDL-cholesterol} ratio as a proxy",
  author    = "DeForest, Natalie and Wang, Yuqi and Zhu, Zhiyi and Dron,
